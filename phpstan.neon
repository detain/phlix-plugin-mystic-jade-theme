parameters:
    level: 9
    paths:
        - src
        - tests
        # The S440 gate script ships fully typed; level-9-clean was measured
        # (W-min137 item 05) with zero ignores, so the auditor can no longer
        # rot unchecked. bright-line: the script itself stays a byte-frozen
        # family template — byte-ident to the jade-family copies (jade and
        # arctic-jade) modulo the single per-repo `@package` line; the md5s
        # differ by that one line, so identity is proven by diff, not hash.
        - scripts
    # `Phlix\Theming\ThemeSourceInterface` is declared by the HOST server, not by
    # any Composer dependency, so PHPStan cannot find it in `vendor/`. It must be
    # INTRODUCED (scanDirectories), not overridden (stubFiles) — `stubFiles` only
    # replaces the definition of a symbol PHPStan can already resolve, so for a
    # genuinely unfindable symbol it is silently useless.
    scanDirectories:
        - dev-stubs
